# Copiá este archivo como .env y completá los valores que te pase el líder POR PRIVADO.
# Nunca subas el .env al repo (está en .gitignore).

# Pooler de transacciones de Supabase (puerto 6543). Integrantes: usuario equipo_dev.
DATABASE_URL=

# Conexión directa (puerto 5432) para migrar. SOLO el líder.
DIRECT_URL=

# Proyecto de Supabase (públicas, pero no se versionan).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Clave secreta (sb_secret_...): seed e invitaciones. SOLO el líder y Vercel. Nunca en el cliente.
SUPABASE_SECRET_KEY=

# Contraseña de los usuarios del seed. SOLO el líder.
SEED_PASSWORD=
